{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.corinthos.local/rpc/v2/command-overview-result.schema.json",
  "type": "object",
  "properties": {
    "projects": { "type": "array", "maxItems": 10, "items": { "$ref": "command-project-result.schema.json" } },
    "limit": { "type": "integer", "minimum": 1, "maximum": 10 },
    "offset": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "next_offset": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000000 }
  },
  "required": ["projects", "limit", "offset", "next_offset"],
  "additionalProperties": false
}
