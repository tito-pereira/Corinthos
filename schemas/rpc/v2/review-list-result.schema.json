{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.corinthos.local/rpc/v2/review-list-result.schema.json",
  "type": "object",
  "properties": {
    "reviews": { "type": "array", "maxItems": 25, "items": { "$ref": "review-summary.schema.json" } },
    "limit": { "$ref": "import-common.schema.json#/$defs/limit" },
    "offset": { "$ref": "import-common.schema.json#/$defs/offset" },
    "next_offset": { "$ref": "import-common.schema.json#/$defs/nextOffset" }
  },
  "required": ["reviews", "limit", "offset", "next_offset"],
  "additionalProperties": false
}
