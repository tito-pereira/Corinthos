{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.corinthos.local/rpc/v2/error.schema.json",
  "oneOf": [
    { "$ref": "https://schemas.corinthos.local/rpc/v1/error.schema.json" },
    {
      "type": "object",
      "properties": {
        "code": { "enum": [-32602, -32002] },
        "message": { "type": "string", "maxLength": 128 },
        "data": {
          "type": "object",
          "properties": {
            "creation_code": {
              "enum": ["INVALID_INPUT", "CONFLICT", "ACCESS_DENIED", "REGISTRY_INCOMPLETE", "STATE_UNAVAILABLE"]
            }
          },
          "required": ["creation_code"],
          "additionalProperties": false
        }
      },
      "required": ["code", "message", "data"],
      "additionalProperties": false
    }
  ]
}
