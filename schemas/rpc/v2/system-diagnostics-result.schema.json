{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.corinthos.local/rpc/v2/system-diagnostics-result.schema.json",
  "type": "object",
  "properties": {
    "python_implementation": { "type": "string", "minLength": 1, "maxLength": 64 },
    "python_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "supported_schema_version": { "type": "integer", "minimum": 1 }
  },
  "required": ["python_implementation", "python_version", "supported_schema_version"],
  "additionalProperties": false
}
